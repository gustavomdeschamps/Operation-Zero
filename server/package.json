{
  "name": "operation-zero-server",
  "version": "2.0.0",
  "private": true,
  "description": "OPERATION ZERO 2.0 \u2014 servidor multiplayer autoritativo (Node.js + Colyseus)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@colyseus/core": "0.18.10",
    "@colyseus/schema": "5.0.42",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.4",
    "express": "4.22.3"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  }
}
