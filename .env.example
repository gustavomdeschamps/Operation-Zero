# OPERATION ZERO — configuração do servidor multiplayer.
# Copie para ".env" (na raiz do projeto) e ajuste. Na hospedagem, defina as mesmas variáveis no painel.

# Porta HTTP/WebSocket do servidor (a hospedagem costuma definir PORT automaticamente)
PORT=2567
HOST=0.0.0.0

# development | production  (production restringe origens à própria URL se ALLOWED_ORIGINS estiver vazio)
NODE_ENV=development

# URL pública do servidor de partidas, usada pelo cliente servido por este mesmo processo.
# Vazio = mesma origem da página (recomendado quando cliente e servidor estão no mesmo domínio).
# Exemplo com domínios separados: PUBLIC_SERVER_URL=https://oz-server.exemplo.com
PUBLIC_SERVER_URL=

# Origens (domínios do cliente) autorizadas a conectar, separadas por vírgula.
# Exemplo: ALLOWED_ORIGINS=https://operation-zero.exemplo.com,https://www.exemplo.com
ALLOWED_ORIGINS=

# Servir os arquivos do jogo por este processo (true) ou só a API/WebSocket (false)
SERVE_CLIENT=true

# Limites
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=10
MAX_CONNECTIONS_PER_IP=12
MIN_PLAYERS_TO_START=2
RECONNECT_SECONDS=20

# Pasta dos dados da economia (contas, inventários, transações). Padrão: server/data/.
# Em hospedagem com disco efêmero (ex.: Render gratuito) os dados se perdem a cada deploy/reinício;
# aponte para um disco persistente para mantê-los. Ver ECONOMY.md.
DATA_DIR=

# Atrás de proxy reverso (Render, Railway, Fly, Nginx): true para usar o IP real do jogador
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info
